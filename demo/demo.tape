# Records demo/demo.mp4. Run with: demo/record.sh
Output demo/raw.mp4
Set Shell bash
Set FontSize 18
Set Width 1280
Set Height 640
Set Padding 24
Set Margin 0
Set WindowBar Colorful
Set WindowBarSize 36
Set BorderRadius 10
Set Theme { "background": "#141414", "foreground": "#e6e6e6", "black": "#141414", "red": "#e5534b", "green": "#57ab5a", "yellow": "#c69026", "blue": "#539bf5", "magenta": "#b083f0", "cyan": "#39c5cf", "white": "#e6e6e6", "brightBlack": "#767676", "brightRed": "#ff938a", "brightGreen": "#6bc46d", "brightYellow": "#daaa3f", "brightBlue": "#6cb6ff", "brightMagenta": "#dcbdfb", "brightCyan": "#56d4dd", "brightWhite": "#ffffff", "cursor": "#d97757", "selection": "#333333" }
Set TypingSpeed 70ms

Hide
Type "source demo/env.sh && clear"
Enter
Sleep 500ms
Show

Sleep 1.2s
Type "cr"
Sleep 600ms
Enter
Sleep 3.3s
Type "webhook"
Sleep 3s
Down
Sleep 1.5s
Up
Sleep 1.2s
Enter
Sleep 4.5s
